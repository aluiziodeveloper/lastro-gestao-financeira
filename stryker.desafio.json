{
  "mutate": ["src/dominio/dinheiro.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --bail 1"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "off",
  "reporters": ["clear-text"],
